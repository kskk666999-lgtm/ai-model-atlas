# ==== 可选数据源密钥（全部只保存在本地或 GitHub Actions Secrets，绝不进入前端）====
# Artificial Analysis 免费数据 API（https://artificialanalysis.ai，限额 1000 次/天）
# 不填写时网站其余榜单照常运行，价格/速度榜将显示"数据接入中"。
AA_API_KEY=

# 可选：GitHub Token，用于提高 GitHub API 速率限额（仓库自身 Actions 中自动提供）
GITHUB_TOKEN=

# 演示模式（生产构建会直接拒绝 DEMO_MODE=true）
DEMO_MODE=false
